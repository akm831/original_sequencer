<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="OSqP01" name="SequencerPrototype" projectType="guiapp"
              version="0.0.1" bundleIdentifier="com.originalsequencer.prototype"
              companyName="original_sequencer" useAppConfig="0"
              addUsingNamespaceToJuceHeader="0" jucerFormatVersion="1">
  <MAINGROUP id="OSqMain" name="SequencerPrototype">
    <GROUP id="OSqApp" name="app">
      <FILE id="OSqMainCpp" name="Main.cpp" compile="1" resource="0" file="app/Main.cpp"/>
    </GROUP>
    <GROUP id="OSqCore" name="common_audio_core">
      <FILE id="OSqCoreCpp" name="AudioCore.cpp" compile="1" resource="0"
            file="../common/audio_core/src/AudioCore.cpp"/>
      <FILE id="OSqCoreHdr" name="AudioCore.h" compile="0" resource="0"
            file="../common/audio_core/include/original_sequencer/prototype/AudioCore.h"/>
    </GROUP>
  </MAINGROUP>

  <EXPORTFORMATS>
    <ANDROIDSTUDIO targetFolder="Builds/Android" androidMinimumSDK="24"
                   androidTargetSDK="36"
                   extraCompilerFlags="-std=c++20"
                   headerPath="../common/audio_core/include">
      <CONFIGURATIONS>
        <CONFIGURATION name="Debug" isDebug="1" optimisation="1"/>
        <CONFIGURATION name="Release" isDebug="0" optimisation="3"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_core" path="../../../JUCE/modules"/>
        <MODULEPATH id="juce_data_structures" path="../../../JUCE/modules"/>
        <MODULEPATH id="juce_events" path="../../../JUCE/modules"/>
        <MODULEPATH id="juce_graphics" path="../../../JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics" path="../../../JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra" path="../../../JUCE/modules"/>
      </MODULEPATHS>
    </ANDROIDSTUDIO>
  </EXPORTFORMATS>

  <MODULES>
    <MODULE id="juce_core" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_events" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_graphics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_extra" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
  </MODULES>

  <JUCEOPTIONS JUCE_STRICT_REFCOUNTEDPOINTER="1"/>
</JUCERPROJECT>
